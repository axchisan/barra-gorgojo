{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "barra-gorgojo",
  "main": "src/servidor/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "BARRA", "class_name": "Barra" }]
  },
  "r2_buckets": [{ "binding": "RESPALDOS", "bucket_name": "barra-gorgojo-respaldos" }],
  "triggers": { "crons": ["30 10 * * *"] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Barra"] }],
  "observability": { "enabled": true },
  // Nombre de la base (instancia del Durable Object). Cambiarlo es pasar a otra base:
  // ver negocio/docs/10. Volver atrás = volver a poner el nombre anterior y desplegar.
  "vars": { "BASE": "reten-del-gorgojo-v2" },

  // Entorno de pruebas: `pnpm desplegar:pruebas`. Otro Worker, así que su Durable
  // Object y sus datos no tienen nada que ver con producción. Sin Cron; respaldos a
  // demanda en su propio bucket. Secretos propios (`wrangler secret put CLAVE --env pruebas`).
  "env": {
    "pruebas": {
      "name": "barra-gorgojo-pruebas",
      "durable_objects": {
        "bindings": [{ "name": "BARRA", "class_name": "Barra" }]
      },
      "r2_buckets": [{ "binding": "RESPALDOS", "bucket_name": "barra-gorgojo-pruebas-respaldos" }],
      "triggers": { "crons": [] },
      "vars": { "BASE": "reten-del-gorgojo-v2" }
    }
  }
}
