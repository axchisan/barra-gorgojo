{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "barra-gorgojo",
  "main": "src/servidor/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "BARRA", "class_name": "Barra" }]
  },
  "r2_buckets": [{ "binding": "RESPALDOS", "bucket_name": "barra-gorgojo-respaldos" }],
  "triggers": { "crons": ["30 10 * * *"] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Barra"] }],
  "observability": { "enabled": true }
}
